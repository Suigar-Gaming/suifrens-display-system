{
	"name": "@suigar/suifrens-display-system",
	"version": "1.0.7",
	"private": true,
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/Suigar-Gaming/suifrens-display-system.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./image": {
			"types": "./dist/image.d.ts",
			"import": "./dist/image.mjs",
			"default": "./dist/image.mjs"
		},
		"./image-inline": {
			"types": "./dist/image-inline.d.ts",
			"import": "./dist/image-inline.mjs",
			"default": "./dist/image-inline.mjs"
		},
		"./image-assets": {
			"types": "./dist/image-assets.d.ts",
			"import": "./dist/image-assets.mjs",
			"default": "./dist/image-assets.mjs"
		},
		"./accessories": {
			"types": "./dist/accessories.d.ts",
			"import": "./dist/accessories.mjs",
			"default": "./dist/accessories.mjs"
		},
		"./colors": {
			"types": "./dist/colors.d.ts",
			"import": "./dist/colors.mjs",
			"default": "./dist/colors.mjs"
		},
		"./attributes": {
			"types": "./dist/attributes.d.ts",
			"import": "./dist/attributes.mjs",
			"default": "./dist/attributes.mjs"
		},
		"./expressions": {
			"types": "./dist/expressions.d.ts",
			"import": "./dist/expressions.mjs",
			"default": "./dist/expressions.mjs"
		},
		"./vip-crowns": {
			"types": "./dist/vip-crowns.d.ts",
			"import": "./dist/vip-crowns.mjs",
			"default": "./dist/vip-crowns.mjs"
		},
		"./animation": {
			"types": "./dist/animation.d.ts",
			"import": "./dist/animation.mjs",
			"default": "./dist/animation.mjs"
		},
		"./battle": {
			"types": "./dist/battle.d.ts",
			"import": "./dist/battle.mjs",
			"default": "./dist/battle.mjs"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.mjs",
			"default": "./dist/types.mjs"
		}
	},
	"scripts": {
		"prepare": "husky",
		"dev": "node --import ./scripts/svg-loader.mjs --import tsx --watch ./src/api/index.ts",
		"storybook": "storybook dev -p 6006",
		"build": "tsx scripts/generate-accessory-assets.tsx && tsdown && tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit -p tsconfig.check.json && tsc -p .storybook/tsconfig.json",
		"build:storybook": "storybook build",
		"test": "vitest run",
		"test:unit": "vitest run tests --exclude tests/package.test.ts",
		"oxlint": "oxlint .",
		"oxlint:fix": "oxlint . --fix",
		"oxfmt": "oxfmt . --check",
		"oxfmt:fix": "oxfmt .",
		"lint": "pnpm run oxlint && pnpm run oxfmt",
		"lint:fix": "pnpm run oxlint:fix && pnpm run oxfmt:fix",
		"release:pack": "pnpm run build && node scripts/pack-release.mjs",
		"changeset": "changeset"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@changesets/config": "^4.0.1",
		"@chromatic-com/storybook": "^5.6.0",
		"@fastify/compress": "^9.3.0",
		"@fastify/cors": "^11.3.1",
		"@fastify/type-provider-typebox": "^6.3.0",
		"@manypkg/cli": "^0.25.1",
		"@mysten/sui": "^2.38.0",
		"@storybook/addon-docs": "^10.6.5",
		"@storybook/addon-links": "^10.6.5",
		"@storybook/addon-onboarding": "^10.6.5",
		"@storybook/react": "^10.6.5",
		"@storybook/react-vite": "^10.6.5",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"ajv-formats": "^3.0.1",
		"fastify": "^5.12.7",
		"happy-dom": "^21.0.4",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"pino-pretty": "^13.2.0",
		"postcss": "^8.5.32",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"storybook": "^10.6.5",
		"tailwindcss": "^4.3.3",
		"tsdown": "^0.23.3",
		"tsx": "^4.23.15",
		"typebox": "^1.4.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0",
		"react-dom": "^18.2.0 || ^19.0.0"
	},
	"engines": {
		"node": "^24.22.1",
		"pnpm": "^12.15.0"
	},
	"packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
